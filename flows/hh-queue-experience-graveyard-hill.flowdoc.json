{
  "flowdoc": "0.2",
  "kind": "flow",
  "name": "hh-queue-experience-graveyard-hill",
  "description": "Queue for the Graveyard Hill crew, offering a move to Old Town when that crew is free. Generated from districts.config.json by generators/districts.ts; edit the config, not this flow.",
  "connectType": "CUSTOMER_QUEUE",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "check-moved",
    "Actions": [
      {
        "Identifier": "check-moved",
        "Type": "Compare",
        "Parameters": {
          "ComparisonValue": "$.Attributes.moved"
        },
        "Transitions": {
          "NextAction": "pick-hold-variant",
          "Errors": [
            {
              "ErrorType": "NoMatchingCondition",
              "NextAction": "pick-hold-variant"
            }
          ],
          "Conditions": [
            {
              "NextAction": "settle-in",
              "Condition": {
                "Operator": "Equals",
                "Operands": [
                  "true"
                ]
              }
            }
          ]
        }
      },
      {
        "Identifier": "pick-hold-variant",
        "Type": "DistributeByPercentage",
        "Parameters": {},
        "Transitions": {
          "NextAction": "note-recorded-variant",
          "Errors": [
            {
              "ErrorType": "NoMatchingCondition",
              "NextAction": "note-recorded-variant"
            }
          ],
          "Conditions": [
            {
              "NextAction": "note-spoken-variant",
              "Condition": {
                "Operator": "NumberLessThan",
                "Operands": [
                  "51"
                ]
              }
            }
          ]
        }
      },
      {
        "Identifier": "note-spoken-variant",
        "Type": "UpdateContactAttributes",
        "Parameters": {
          "Attributes": {
            "holdVariant": "spoken"
          },
          "TargetContact": "Current"
        },
        "Transitions": {
          "NextAction": "tag-spoken-variant",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "poll-crews"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "tag-spoken-variant",
        "Type": "TagContact",
        "Parameters": {
          "Tags": {
            "holdVariant": "spoken"
          }
        },
        "Transitions": {
          "NextAction": "poll-crews",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "poll-crews"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "note-recorded-variant",
        "Type": "UpdateContactAttributes",
        "Parameters": {
          "Attributes": {
            "holdVariant": "recorded"
          },
          "TargetContact": "Current"
        },
        "Transitions": {
          "NextAction": "tag-recorded-variant",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "poll-crews"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "tag-recorded-variant",
        "Type": "TagContact",
        "Parameters": {
          "Tags": {
            "holdVariant": "recorded"
          }
        },
        "Transitions": {
          "NextAction": "poll-crews",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "poll-crews"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "poll-crews",
        "Type": "Loop",
        "Parameters": {
          "LoopCount": "3"
        },
        "Transitions": {
          "NextAction": "settle-in",
          "Errors": [],
          "Conditions": [
            {
              "NextAction": "check-eta",
              "Condition": {
                "Operator": "Equals",
                "Operands": [
                  "ContinueLooping"
                ]
              }
            },
            {
              "NextAction": "settle-in",
              "Condition": {
                "Operator": "Equals",
                "Operands": [
                  "DoneLooping"
                ]
              }
            }
          ]
        }
      },
      {
        "Identifier": "check-eta",
        "Type": "InvokeLambdaFunction",
        "Parameters": {
          "InvocationTimeLimitSeconds": 3,
          "InvocationType": "SYNCHRONOUS",
          "LambdaFunctionARN": "${cdref:lambda:crew-eta}",
          "LambdaInvocationAttributes": {
            "district": "graveyard-hill"
          },
          "ResponseValidation": {
            "ResponseType": "JSON"
          }
        },
        "Transitions": {
          "NextAction": "share-eta",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "check-sibling"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "share-eta",
        "Type": "MessageParticipant",
        "Parameters": {
          "Text": "The Graveyard Hill crew expects to be free in about $.External.etaMinutes minutes."
        },
        "Transitions": {
          "NextAction": "check-eta-band",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "check-sibling"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "check-eta-band",
        "Type": "Compare",
        "Parameters": {
          "ComparisonValue": "$.External.etaBand"
        },
        "Transitions": {
          "NextAction": "check-sibling",
          "Errors": [
            {
              "ErrorType": "NoMatchingCondition",
              "NextAction": "check-sibling"
            }
          ],
          "Conditions": [
            {
              "NextAction": "offer-callback",
              "Condition": {
                "Operator": "Equals",
                "Operands": [
                  "later"
                ]
              }
            }
          ]
        }
      },
      {
        "Identifier": "offer-callback",
        "Type": "GetParticipantInput",
        "Parameters": {
          "InputTimeLimitSeconds": "6",
          "StoreInput": "False",
          "Text": "That is a long wait. For a callback from the next crew that comes free, press 1. To keep your place in line, press 2."
        },
        "Transitions": {
          "NextAction": "check-sibling",
          "Errors": [
            {
              "ErrorType": "InputTimeLimitExceeded",
              "NextAction": "check-sibling"
            },
            {
              "ErrorType": "NoMatchingCondition",
              "NextAction": "check-sibling"
            },
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "check-sibling"
            }
          ],
          "Conditions": [
            {
              "NextAction": "set-callback-number",
              "Condition": {
                "Operator": "Equals",
                "Operands": [
                  "1"
                ]
              }
            },
            {
              "NextAction": "check-sibling",
              "Condition": {
                "Operator": "Equals",
                "Operands": [
                  "2"
                ]
              }
            }
          ]
        }
      },
      {
        "Identifier": "set-callback-number",
        "Type": "UpdateContactCallbackNumber",
        "Parameters": {
          "CallbackNumber": "$.CustomerEndpoint.Address"
        },
        "Transitions": {
          "NextAction": "create-callback",
          "Errors": [
            {
              "ErrorType": "InvalidCallbackNumber",
              "NextAction": "cannot-ring-back"
            },
            {
              "ErrorType": "CallbackNumberNotDialable",
              "NextAction": "cannot-ring-back"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "cannot-ring-back",
        "Type": "MessageParticipant",
        "Parameters": {
          "Text": "We cannot ring you back at the number you are calling from, so we will keep your place in line."
        },
        "Transitions": {
          "NextAction": "hold",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "hold"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "create-callback",
        "Type": "CreateCallbackContact",
        "Parameters": {
          "InitialCallDelaySeconds": "60",
          "MaximumConnectionAttempts": "2",
          "QueueId": "${cdref:queue:dispatch-overflow}",
          "RetryDelaySeconds": "600"
        },
        "Transitions": {
          "NextAction": "callback-taken",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "callback-refused"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "callback-refused",
        "Type": "MessageParticipant",
        "Parameters": {
          "Text": "We cannot take a callback right now, so we will keep your place in line."
        },
        "Transitions": {
          "NextAction": "hold",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "hold"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "callback-taken",
        "Type": "MessageParticipant",
        "Parameters": {
          "Text": "You are on the list. A crew will call you back as soon as one comes free. Keep the lights on until then."
        },
        "Transitions": {
          "NextAction": "let-go",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "let-go"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "let-go",
        "Type": "DisconnectParticipant",
        "Parameters": {},
        "Transitions": {}
      },
      {
        "Identifier": "check-sibling",
        "Type": "CheckMetricData",
        "Parameters": {
          "MetricType": "NumberOfAgentsAvailable",
          "QueueId": "${cdref:queue:old-town-crew}"
        },
        "Transitions": {
          "NextAction": "hold",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "hold"
            },
            {
              "ErrorType": "NoMatchingCondition",
              "NextAction": "hold"
            }
          ],
          "Conditions": [
            {
              "NextAction": "offer-move",
              "Condition": {
                "Operator": "NumberGreaterThan",
                "Operands": [
                  "0"
                ]
              }
            }
          ]
        }
      },
      {
        "Identifier": "offer-move",
        "Type": "GetParticipantInput",
        "Parameters": {
          "InputTimeLimitSeconds": "6",
          "StoreInput": "False",
          "Text": "The Old Town crew has someone free right now. To move to them, press 1. To keep your place here, press 2."
        },
        "Transitions": {
          "NextAction": "hold",
          "Errors": [
            {
              "ErrorType": "InputTimeLimitExceeded",
              "NextAction": "hold"
            },
            {
              "ErrorType": "NoMatchingCondition",
              "NextAction": "hold"
            },
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "hold"
            }
          ],
          "Conditions": [
            {
              "NextAction": "note-move",
              "Condition": {
                "Operator": "Equals",
                "Operands": [
                  "1"
                ]
              }
            },
            {
              "NextAction": "hold",
              "Condition": {
                "Operator": "Equals",
                "Operands": [
                  "2"
                ]
              }
            }
          ]
        }
      },
      {
        "Identifier": "note-move",
        "Type": "UpdateContactAttributes",
        "Parameters": {
          "Attributes": {
            "district": "old-town",
            "districtName": "Old Town",
            "moved": "true"
          },
          "TargetContact": "Current"
        },
        "Transitions": {
          "NextAction": "moving",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "hold"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "moving",
        "Type": "MessageParticipantIteratively",
        "Parameters": {
          "InterruptFrequencySeconds": "5",
          "Messages": [
            {
              "Text": "Moving you to the Old Town crew now."
            }
          ]
        },
        "Transitions": {
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "stay-here"
            }
          ],
          "Conditions": [
            {
              "NextAction": "move-to-sibling",
              "Condition": {
                "Operator": "Equals",
                "Operands": [
                  "MessagesInterrupted"
                ]
              }
            }
          ]
        }
      },
      {
        "Identifier": "move-to-sibling",
        "Type": "DequeueContactAndTransferToQueue",
        "Parameters": {
          "QueueId": "${cdref:queue:old-town-crew}"
        },
        "Transitions": {
          "NextAction": "done",
          "Errors": [
            {
              "ErrorType": "QueueAtCapacity",
              "NextAction": "sibling-full"
            },
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "stay-here"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "sibling-full",
        "Type": "MessageParticipant",
        "Parameters": {
          "Text": "The Old Town crew just filled up. You still have your place with Graveyard Hill."
        },
        "Transitions": {
          "NextAction": "stay-here",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "stay-here"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "stay-here",
        "Type": "UpdateContactAttributes",
        "Parameters": {
          "Attributes": {
            "district": "graveyard-hill",
            "districtName": "Graveyard Hill",
            "moved": "false"
          },
          "TargetContact": "Current"
        },
        "Transitions": {
          "NextAction": "hold",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "hold"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "hold",
        "Type": "Compare",
        "Parameters": {
          "ComparisonValue": "$.Attributes.holdVariant"
        },
        "Transitions": {
          "NextAction": "hold-spoken",
          "Errors": [
            {
              "ErrorType": "NoMatchingCondition",
              "NextAction": "hold-spoken"
            }
          ],
          "Conditions": [
            {
              "NextAction": "hold-recorded",
              "Condition": {
                "Operator": "Equals",
                "Operands": [
                  "recorded"
                ]
              }
            }
          ]
        }
      },
      {
        "Identifier": "hold-spoken",
        "Type": "MessageParticipantIteratively",
        "Parameters": {
          "InterruptFrequencySeconds": "30",
          "Messages": [
            {
              "Text": "While you wait: keep the lights on, keep pets close, and stay in a room with a door you can open."
            },
            {
              "Text": "A line of salt across the doorway never hurts. Nor does a cup of tea."
            }
          ]
        },
        "Transitions": {
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "settle-in"
            }
          ],
          "Conditions": [
            {
              "NextAction": "poll-crews",
              "Condition": {
                "Operator": "Equals",
                "Operands": [
                  "MessagesInterrupted"
                ]
              }
            }
          ]
        }
      },
      {
        "Identifier": "hold-recorded",
        "Type": "MessageParticipantIteratively",
        "Parameters": {
          "InterruptFrequencySeconds": "30",
          "Messages": [
            {
              "PromptId": "${cdref:prompt:salt-line-tips}"
            }
          ]
        },
        "Transitions": {
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "hold-spoken"
            }
          ],
          "Conditions": [
            {
              "NextAction": "poll-crews",
              "Condition": {
                "Operator": "Equals",
                "Operands": [
                  "MessagesInterrupted"
                ]
              }
            }
          ]
        }
      },
      {
        "Identifier": "settle-in",
        "Type": "MessageParticipantIteratively",
        "Parameters": {
          "Messages": [
            {
              "Text": "You are still in line for the $.Attributes.districtName crew, and they know you are waiting."
            },
            {
              "Text": "Keep the lights on and stay with others. A crew member will be with you soon."
            }
          ]
        },
        "Transitions": {
          "Errors": [],
          "Conditions": []
        }
      },
      {
        "Identifier": "done",
        "Type": "EndFlowExecution",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  },
