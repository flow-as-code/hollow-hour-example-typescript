{
  "flowdoc": "0.2",
  "kind": "flow",
  "name": "hh-district-menu",
  "description": "The keypad district menu, one key per district. Generated from districts.config.json by generators/districts.ts; edit the config, not this flow.",
  "connectType": "CONTACT_FLOW",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "ask-district",
    "Actions": [
      {
        "Identifier": "ask-district",
        "Type": "GetParticipantInput",
        "Parameters": {
          "InputTimeLimitSeconds": "8",
          "StoreInput": "False",
          "Text": "Where are you calling from? For Old Town, press 1. For Harborside, press 2. For Graveyard Hill, press 3."
        },
        "Transitions": {
          "NextAction": "hand-to-dispatch",
          "Errors": [
            {
              "ErrorType": "InputTimeLimitExceeded",
              "NextAction": "hand-to-dispatch"
            },
            {
              "ErrorType": "NoMatchingCondition",
              "NextAction": "hand-to-dispatch"
            },
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "hand-to-dispatch"
            }
          ],
          "Conditions": [
            {
              "NextAction": "route-old-town",
              "Condition": {
                "Operator": "Equals",
                "Operands": [
                  "1"
                ]
              }
            },
            {
              "NextAction": "route-harborside",
              "Condition": {
                "Operator": "Equals",
                "Operands": [
                  "2"
                ]
              }
            },
            {
              "NextAction": "route-graveyard-hill",
              "Condition": {
                "Operator": "Equals",
                "Operands": [
                  "3"
                ]
              }
            }
          ]
        }
      },
      {
        "Identifier": "route-old-town",
        "Type": "UpdateContactAttributes",
        "Parameters": {
          "Attributes": {
            "district": "old-town",
            "districtName": "Old Town"
          },
          "TargetContact": "Current"
        },
        "Transitions": {
          "NextAction": "to-old-town",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "hand-to-dispatch"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "to-old-town",
        "Type": "TransferToFlow",
        "Parameters": {
          "ContactFlowId": "${cdref:flow:hh-district-old-town}"
        },
        "Transitions": {
          "NextAction": "hang-up",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "hand-to-dispatch"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "route-harborside",
        "Type": "UpdateContactAttributes",
        "Parameters": {
          "Attributes": {
            "district": "harborside",
            "districtName": "Harborside"
          },
          "TargetContact": "Current"
        },
        "Transitions": {
          "NextAction": "to-harborside",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "hand-to-dispatch"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "to-harborside",
        "Type": "TransferToFlow",
        "Parameters": {
          "ContactFlowId": "${cdref:flow:hh-district-harborside}"
        },
        "Transitions": {
          "NextAction": "hang-up",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "hand-to-dispatch"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "route-graveyard-hill",
        "Type": "UpdateContactAttributes",
        "Parameters": {
          "Attributes": {
            "district": "graveyard-hill",
            "districtName": "Graveyard Hill"
          },
          "TargetContact": "Current"
        },
        "Transitions": {
          "NextAction": "to-graveyard-hill",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "hand-to-dispatch"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "to-graveyard-hill",
        "Type": "TransferToFlow",
        "Parameters": {
          "ContactFlowId": "${cdref:flow:hh-district-graveyard-hill}"
        },
        "Transitions": {
          "NextAction": "hang-up",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "hand-to-dispatch"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "hand-to-dispatch",
        "Type": "MessageParticipant",
        "Parameters": {
          "Text": "Let me put you through to a dispatcher."
        },
        "Transitions": {
          "NextAction": "note-dispatch",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "note-dispatch"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "note-dispatch",
        "Type": "UpdateContactAttributes",
        "Parameters": {
          "Attributes": {
            "districtName": "Dispatch"
          },
          "TargetContact": "Current"
        },
        "Transitions": {
          "NextAction": "set-dispatch-customer-whisper",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "set-dispatch-customer-whisper"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "set-dispatch-customer-whisper",
        "Type": "UpdateContactEventHooks",
        "Parameters": {
          "EventHooks": {
            "CustomerWhisper": "${cdref:flow:hh-customer-whisper}"
          }
        },
        "Transitions": {
          "NextAction": "set-dispatch-agent-whisper",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "set-dispatch-agent-whisper"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "set-dispatch-agent-whisper",
        "Type": "UpdateContactEventHooks",
        "Parameters": {
          "EventHooks": {
            "AgentWhisper": "${cdref:flow:hh-agent-whisper}"
          }
        },
        "Transitions": {
          "NextAction": "set-dispatch-customer-hold",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "set-dispatch-customer-hold"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "set-dispatch-customer-hold",
        "Type": "UpdateContactEventHooks",
        "Parameters": {
          "EventHooks": {
            "CustomerHold": "${cdref:flow:hh-customer-hold}"
          }
        },
        "Transitions": {
          "NextAction": "set-dispatch-agent-hold",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "set-dispatch-agent-hold"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "set-dispatch-agent-hold",
        "Type": "UpdateContactEventHooks",
        "Parameters": {
          "EventHooks": {
            "AgentHold": "${cdref:flow:hh-agent-hold}"
          }
        },
        "Transitions": {
          "NextAction": "set-dispatch-queue",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "set-dispatch-queue"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "set-dispatch-queue",
        "Type": "UpdateContactTargetQueue",
        "Parameters": {
          "QueueId": "${cdref:queue:dispatch-overflow}"
        },
        "Transitions": {
          "NextAction": "transfer-to-dispatch",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "apologize"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "transfer-to-dispatch",
        "Type": "TransferContactToQueue",
        "Parameters": {},
        "Transitions": {
          "NextAction": "hang-up",
          "Errors": [
            {
              "ErrorType": "QueueAtCapacity",
              "NextAction": "lines-busy"
            },
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "apologize"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "lines-busy",
        "Type": "MessageParticipant",
        "Parameters": {
          "Text": "Every crew is out on a call. Please call back in a few minutes."
        },
        "Transitions": {
          "NextAction": "hang-up",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "hang-up"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "apologize",
        "Type": "MessageParticipant",
        "Parameters": {
          "Text": "Something went wrong on our side. Please call back in a few minutes."
        },
        "Transitions": {
          "NextAction": "hang-up",
          "Errors": [
            {
              "ErrorType": "NoMatchingError",
              "NextAction": "hang-up"
            }
          ],
          "Conditions": []
        }
      },
      {
        "Identifier": "hang-up",
        "Type": "DisconnectParticipant",
        "Parameters": {},
        "Transitions": {}
      }
    ]
  },
