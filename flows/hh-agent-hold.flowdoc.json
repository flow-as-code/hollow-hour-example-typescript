{
  "flowdoc": "0.2",
  "kind": "flow",
  "name": "hh-agent-hold",
  "description": "What the crew member hears while the caller has them on hold. One loop of prompts and nothing else: MessageParticipant and every terminal type are illegal in hold flows, and a loop with no next ends the flow. Reads contact attributes only.",
  "connectType": "AGENT_HOLD",
  "content": {
    "Version": "2019-10-30",
    "StartAction": "on-hold",
    "Actions": [
      {
        "Identifier": "on-hold",
        "Type": "MessageParticipantIteratively",
        "Parameters": {
          "Messages": [
            {
              "Text": "Caller on hold. Grade $.Attributes.gradeName."
            }
          ]
        },
        "Transitions": {
          "Errors": [],
          "Conditions": []
        }
      }
    ]
  },
